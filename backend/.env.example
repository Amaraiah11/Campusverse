PORT=5000
NODE_ENV=development

# =================================================================
# SUPABASE CONFIGURATION
# Found under: Project Settings -> API in your Supabase Dashboard
# =================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# =================================================================
# AI AGENT & EMBEDDINGS CONFIGURATION
# Supports: openai | gemini | groq | ollama
# =================================================================
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# =================================================================
# UPLOAD VALIDATION LIMITS
# =================================================================
MAX_FILE_SIZE_MB=25
MAX_PAGE_COUNT=150
MAX_SLIDE_COUNT=150
MAX_DESCRIPTION_WORDS=25
